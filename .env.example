# Copy this file to .env and adjust values for your machine.
# Hosts use localhost for running the app on your laptop (uv run).
# compose.yml overrides them with container names when running in Docker.

# Application
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development
SERVICE_NAME=rag-api

# PostgreSQL
POSTGRES_DATABASE_URL=postgresql+psycopg2://rag_user:rag_password@localhost:5432/rag_db
POSTGRES_ECHO_SQL=true
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=0

# OpenSearch
OPENSEARCH_HOST=http://localhost:9200

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODELS=llama3.2:1b
OLLAMA_DEFAULT_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=300
